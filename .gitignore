*.tsbuildinfo

# Local render output. Renders are throwaway by default; the ones that are part
# of the project — README examples and the site's own assets — are exceptions.
out/
*.png
!examples/*.png
!docs/**/*.png
!web/*.png

# Caches
.cache/
.iso-cities-cache/

# The outbreak simulation's raw Overpass/Wikidata responses — 180 MB of
# per-query dumps that fetch-data.mjs will re-download on demand. The frozen,
# compact artefacts (region.json, outbreak.json) are kept, so the film can be
# re-rendered without touching the network at all.
outbreak/data/raw-*.json

